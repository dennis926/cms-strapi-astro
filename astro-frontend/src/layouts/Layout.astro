---
// 全局布局
const { title, description, image, jsonld, seo, geoMeta } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!DOCTYPE html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    
    <!-- SEO Meta -->
    <title>{seo?.seoTitle || title}</title>
    <meta name="description" content={seo?.seoDescription || description} />
    <link rel="canonical" href={seo?.seoCanonical || canonicalURL.href} />
    <meta name="robots" content={seo?.seoRobots || 'index,follow'} />
    
    <!-- Open Graph -->
    <meta property="og:title" content={seo?.ogTitle || title} />
    <meta property="og:description" content={seo?.ogDescription || description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL.href} />
    {seo?.ogImage && <meta property="og:image" content={seo.ogImage} />}
    
    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={seo?.ogTitle || title} />
    <meta name="twitter:description" content={seo?.ogDescription || description} />
    {seo?.ogImage && <meta name="twitter:image" content={seo.ogImage} />}
    
    <!-- JSON-LD Structured Data -->
    {jsonld && <script type="application/ld+json" set:html={JSON.stringify(jsonld)} />}
    
    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    
    <!-- Preconnect -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  </head>
  <body>
    <!-- 导航栏 -->
    <header class="sticky top-0 z-50 bg-surface/80 backdrop-blur-md border-b border-border">
      <nav class="max-w-6xl mx-auto px-6 py-4 flex items-center justify-between">
        <a href="/" class="font-display text-2xl font-bold">卿尔美</a>
        <ul class="hidden md:flex gap-8">
          <li><a href="/about" class="hover:text-primary transition-colors">关于我们</a></li>
          <li><a href="/products" class="hover:text-primary transition-colors">产品中心</a></li>
          <li><a href="/articles" class="hover:text-primary transition-colors">健康资讯</a></li>
          <li><a href="/news" class="hover:text-primary transition-colors">新闻动态</a></li>
          <li><a href="/franchise" class="hover:text-primary transition-colors">招商合作</a></li>
          <li><a href="/contact" class="hover:text-primary transition-colors">联系我们</a></li>
        </ul>
        <button class="md:hidden p-2" id="menu-toggle">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
          </svg>
        </button>
      </nav>
    </header>

    <!-- 主内容 -->
    <main>
      <slot />
    </main>

    <!-- 页脚 -->
    <footer class="bg-surface-elevated border-t border-border py-12">
      <div class="max-w-6xl mx-auto px-6">
        <div class="grid md:grid-cols-4 gap-8">
          <div>
            <h3 class="font-display text-xl font-bold mb-4">卿尔美</h3>
            <p class="text-text-muted">专注健康食品，传承养生智慧</p>
          </div>
          <div>
            <h4 class="font-semibold mb-4">快速链接</h4>
            <ul class="space-y-2 text-text-muted">
              <li><a href="/about" class="hover:text-primary">关于我们</a></li>
              <li><a href="/products" class="hover:text-primary">产品中心</a></li>
              <li><a href="/articles" class="hover:text-primary">健康资讯</a></li>
            </ul>
          </div>
          <div>
            <h4 class="font-semibold mb-4">服务支持</h4>
            <ul class="space-y-2 text-text-muted">
              <li><a href="/franchise" class="hover:text-primary">招商合作</a></li>
              <li><a href="/contact" class="hover:text-primary">联系我们</a></li>
            </ul>
          </div>
          <div>
            <h4 class="font-semibold mb-4">联系方式</h4>
            <ul class="space-y-2 text-text-muted">
              <li>电话：400-xxx-xxxx</li>
              <li>邮箱：info@qingermei.com</li>
            </ul>
          </div>
        </div>
        <div class="mt-8 pt-8 border-t border-border text-center text-text-muted text-sm">
          <p>&copy; 2026 卿尔美 版权所有</p>
        </div>
      </div>
    </footer>

    <script>
      // 移动端菜单切换
      const menuToggle = document.getElementById('menu-toggle');
      menuToggle?.addEventListener('click', () => {
        // TODO: 实现菜单展开
      });
    </script>
  </body>
</html>
