---
import Layout from '@layouts/Layout.astro';
import { getArticles } from '@utils/api';

const articles = await getArticles();
---

<Layout title="健康资讯" description="健康养生知识">
  <section class="py-section">
    <div class="max-w-6xl mx-auto px-6">
      <h1 class="font-display text-4xl md:text-6xl font-bold text-center mb-12">健康资讯</h1>
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        {articles.data?.map((article: any) => (
          <a href={`/articles/${article.slug}`} class="group">
            <article class="bg-surface-elevated rounded-lg overflow-hidden shadow-sm hover:shadow-lg transition-shadow">
              <div class="aspect-video bg-border">
                {article.cover && <img src={article.cover.url} alt={article.title} class="w-full h-full object-cover" />}
              </div>
              <div class="p-6">
                <h2 class="text-lg font-semibold group-hover:text-primary transition-colors line-clamp-2">{article.title}</h2>
                <p class="text-text-muted mt-2 line-clamp-2">{article.excerpt}</p>
                <p class="text-sm text-text-muted mt-4">{new Date(article.publishedAt).toLocaleDateString('zh-CN')}</p>
              </div>
            </article>
          </a>
        ))}
      </div>
    </div>
  </section>
</Layout>
