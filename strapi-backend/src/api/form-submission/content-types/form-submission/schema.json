{
  "kind": "collectionType",
  "info": {
    "singularName": "form-submission",
    "pluralName": "form-submissions",
    "displayName": "表单提交",
    "name": "FormSubmission",
    "description": "表单提交（招商申请、在线留言）"
  },
  "pluginOptions": {},
  "attributes": {
    "formType": {
      "type": "enumeration",
      "enum": ["franchise", "contact", "other"],
      "required": true,
      "default": "contact"
    },
    "name": { "type": "string", "required": true },
    "phone": { "type": "string", "required": true },
    "email": { "type": "email" },
    "company": { "type": "string" },
    "message": { "type": "text", "required": true },
    "submissionStatus": {
      "type": "enumeration",
      "enum": ["new", "processing", "resolved", "archived"],
      "default": "new"
    },
    "notes": { "type": "text" },
    "ipAddress": { "type": "string" },
    "userAgent": { "type": "string" }
  }
}
